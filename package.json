{
  "name": "polybridge-ventures-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Polybridge Ventures Trading Management CRM Monorepo",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "postinstall": "pnpm --filter @polybridge/contracts build",
    "dev": "pnpm --filter \"@polybridge/*\" --parallel dev",
    "build": "pnpm --filter \"@polybridge/*\" build",
    "typecheck": "pnpm --filter @polybridge/contracts build && pnpm --filter \"@polybridge/*\" typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter \"@polybridge/*\" test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
