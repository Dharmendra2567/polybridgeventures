# Polybridge Ventures - Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT. NEVER COMMIT REAL CREDENTIALS.

# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS & Frontend URL
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_API_BASE_URL=/api/v1

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://polybridge_dev:polybridge_password@localhost:5432/polybridge_trading_dev?schema=public

# Session & Security Secrets (Generate using `openssl rand -hex 32`)
COOKIE_SECRET=change-this-to-a-secure-32-byte-hex-string-for-session-cookies
SESSION_MAX_AGE_SECONDS=28800

# Structured Logging
LOG_LEVEL=info
